# aaPanel-style nginx vhost for Cypht multi-account webmail
# Domain: allmail.voxbulk.com → 127.0.0.1:CYPHT_HOST_PORT (default 8090)
# Installed by scripts/vps-setup-cypht.sh

server
{
    listen 80;
    listen [::]:80;
    server_name allmail.voxbulk.com;
    index index.html index.htm;
    root /www/wwwroot/allmail.voxbulk.com;
    include /www/server/panel/vhost/nginx/extension/allmail.voxbulk.com/*.conf;
    include /www/server/panel/vhost/nginx/well-known/allmail.voxbulk.com.conf;

    location / {
        return 301 https://$host$request_uri;
    }
    access_log  /www/wwwlogs/allmail.voxbulk.com.log;
    error_log  /www/wwwlogs/allmail.voxbulk.com.error.log;
}

server
{
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name allmail.voxbulk.com;
    index index.html index.htm;
    root /www/wwwroot/allmail.voxbulk.com;
    include /www/server/panel/vhost/nginx/extension/allmail.voxbulk.com/*.conf;
    include /www/server/panel/vhost/nginx/well-known/allmail.voxbulk.com.conf;

    #SSL-START
    ssl_certificate    __SSL_CERT__;
    ssl_certificate_key    __SSL_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers EECDH+CHACHA20:EECDH+AES128:RSA+AES128:EECDH+AES256:RSA+AES256:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000";
    error_page 497  https://$host$request_uri;
    #SSL-END

    client_max_body_size 60m;

    location / {
        proxy_pass http://127.0.0.1:__CYPHT_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }

    access_log  /www/wwwlogs/allmail.voxbulk.com.log;
    error_log  /www/wwwlogs/allmail.voxbulk.com.error.log;
}
